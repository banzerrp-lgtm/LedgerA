# Configuración web pública del proyecto Firebase de Ledger.
# Copia este archivo a .env.local y completa los valores de Firebase Console.
# Esta configuración no contiene secretos; no uses claves privadas aquí.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
